# Copy to .env for local development. Never commit .env.

# development | production | test
APP_ENV=development
HTTP_ADDR=:8080

# Postgres from the root docker-compose.yml
DATABASE_URL=postgres://newsp:newsp@localhost:5432/newsp?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info
# text | json (defaults to json in production)
LOG_FORMAT=

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:5173

SHUTDOWN_TIMEOUT=20s
# Serves /swagger/* (defaults to true outside production)
SWAGGER_ENABLED=

# Signs access tokens. At least 32 bytes; generate with `openssl rand -base64 48`.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Public URL of the web app; invite and password reset links point here.
APP_BASE_URL=http://localhost:5173

# E-mail (optional). Empty SMTP_HOST: in development the e-mail (with its link)
# is printed in the log. SMTP_TLS: starttls (587), tls (465) or none (Mailpit).
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_TLS=tls SMTP_USERNAME=resend
# SMTP_PASSWORD=<Resend API key>, MAIL_FROM on a verified domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
MAIL_FROM=

# Networks allowed to set X-Forwarded-For (the web BFF). Comma-separated CIDRs.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Encrypts provider API keys at rest: base64 of 32 random bytes (`openssl rand -base64 32`).
ENCRYPTION_KEY=ZGV2LW9ubHktaW5zZWN1cmUtZW5jcnlwdGlvbi1rZXk=

# Accept sslmode=disable in production. Only for a database on a private
# network, such as the docker compose stack.
DATABASE_ALLOW_PLAINTEXT=false
