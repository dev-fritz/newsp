# Copy to .env for local development. Never commit .env.

# Go API as seen from the web server (the browser never talks to it directly).
API_URL=http://localhost:8080
# Encrypts the session cookie; at least 32 characters (`openssl rand -base64 48`).
SESSION_SECRET=dev-only-insecure-session-secret-change-me-012345
# Public origin of this app; mutations from other origins are refused.
APP_ORIGIN=http://localhost:5173
